# Template. Copy to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.
# Every name below except ANTHROPIC_API_KEY and ANTHROPIC_MODEL is required to start the server.

# App login — the gate in front of every page (ADR-011)
APP_USERNAME=
APP_PASSWORD=

# Dashboard logins, injected into observations_laptop.html at serve time (ADR-010)
COACH_PASSWORD=
PRINCIPAL_PASSWORD=
ADMIN_PASSWORD=

# Claude API — only /ask needs this; it returns a clean 503 if absent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Server
PORT=8787
